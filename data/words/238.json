"后","他","也","拒绝","再","参选","连任"]]],"entries":[{"trad":"修正","pinyin":"xiūzhèng","senses":["to revise; to amend; to rectify"],"source":"cc-cedict","hv":"tu chính,chánh"},{"trad":"修正","pinyin":"xiūzhèng","senses":["to revise; to amend; to correct"],"pos":"verb","source":"wiktionary"},{"trad":"修正","pinyin":"xiūzhèng","senses":["kind-hearted and upright"],"pos":"adj","source":"wiktionary"}]},"蛮子":{"examples":[["ud-gsdsimp-l7-004",48,7,"但在当时，蒙古八旗后裔的蒙古族身份已不被蒙古盟旗广泛承认，甚至还被呼之为“蛮子”。","但在當時，蒙古八旗後裔的蒙古族身份已不被蒙古盟旗廣泛承認，甚至還被呼之為“蠻子”。",["但","在","当时","旗","后裔","的","族","身份","已","不","被","盟旗","广泛","承认","甚至","还","呼","之","为"]]],"entries":[{"trad":"蠻子","pinyin":"mánzi","senses":["barbarian","slave servant","(old) contemptuous term for people from southern China (used by northern Chinese people)"],"source":"cc-cedict","hv":"man tử"},{"trad":"蠻子","pinyin":"mánzi","senses":["southern barbarian; southerner; someone from southern China","A name for Song China (particularly) under the Yuan"],"pos":"noun","source":"wiktionary"}]},"问世":{"examples":[["ud-gsdsimp-l10-001",22,10,"问世之初可口可乐的主要成分主要有两种，分别是古柯碱及咖啡因。","問世之初可口可樂的主要成分主要有兩種，分別是古柯鹼及咖啡因。",["之初","的","主要","成分","有","种","分别","是","古柯碱","及","咖啡因"]]],"entries":[{"trad":"問世","pinyin":"wènshì","senses":["to be published","to come out"],"source":"cc-cedict","hv":"vấn thế"},{"trad":"問世","pinyin":"wènshì","senses":["to come out; to be published; to come on the scene; to come into being"],"pos":"verb","source":"wiktionary"}]},"修缮":{"examples":[["ud-gsdsimp-l10-001",36,10,"主要职责是管理宫廷的修缮、食事、扫除、医疗等事庶务，以及天皇财产的管理。","主要職責是管理宮廷的修繕、食事、掃除、醫療等事庶務，以及天皇財產的管理。",["主要","职责","是","管理","宫廷","的","食事","扫除","医疗","等","事","庶务","以及","天皇","财产"]]],"entries":[{"trad":"修繕","pinyin":"xiūshàn","senses":["to renovate","to repair (a building)"],"source":"cc-cedict","hv":"tu thiện"},{"trad":"修繕","pinyin":"xiūshàn","senses":["to repair (especially a structure); to renovate"],"pos":"verb","source":"wiktionary"}]},"修改":{"examples":[["ud-gsdsimp-l10-002",26,10,"其枪机是以AK-47的双大形闭锁锁耳枪机为蓝本，并且经过相当的修改使其适用于大威力的反器材步枪上。","其槍機是以AK-47的雙大形閉鎖鎖耳槍機為藍本，並且經過相當的修改使其適用於大威力的反器材步槍上。",["其","枪机","是","以","的","大形","闭锁","锁耳","为","蓝本","并且","经过","相当","使","适用","于","大","威力","反","器材","步枪","上"]]],"entries":[{"trad":"修改","pinyin":"xiūgǎi","senses":["to amend","to alter","to modify"],"source":"cc-cedict","hv":"tu cải"},{"trad":"修改","pinyin":"xiūgǎi","senses":["to revise; to alter; to modify; to amend; to rework; to revamp; to mend","to change; to alter; to modify"],"pos":"verb","source":"wiktionary"}],"usage":{"n":6,"rank":4201,"gold":1,"machine":5,"lv":[0,0,0,0,3,0,1,2],"upos":[["NOUN",4,["ud-gsdsimp-l10-002",26]],["VERB",2,null]],"rel":[["obj",3],["advcl",1],["obl",1],["root",1]]}},"壮年":{"examples":[["ud-gsdsimp-l10-003",35,10,"事件最初不为留意，直到1980年代泡沫经济破灭，同公司几位较高职位的行政人员正值壮年，却在没有明显疾病的情况下猝死。","事件最初不為留意，直到1980年代泡沫經濟破滅，同公司幾位較高職位的行政人員正值壯年，卻在沒有明顯疾病的情況下猝死。",["事件","最初","不","为","留意","直到","年代","泡沫","经济","破灭","同","公司","位","较高","职位","的","行政","人员","正","值","却","在","没有","明显","疾病","情况","下","猝死"]]],"entries":[{"trad":"壯年","pinyin":"zhuàngnián","senses":["lit. robust years","prime of life","summer","able-bodied (fit for military service)","mature (talent, garden etc)"],"source":"cc-cedict","hv":"tráng niên"},{"trad":"壯年","pinyin":"zhuàngnián","senses":["prime of life; more robust years of a person's life (between thirty and forty or fifty)"],"pos":"noun","source":"wiktionary"}]},"修道院":{"examples":[["ud-pud-l7-004",21,7,"在他们之间的是圣彼得圣保罗修道院教堂的旧回廊。","在他們之間的是聖彼得聖保羅修道院教堂的舊迴廊。",["在","他们","之间","的","是","圣","教堂","旧回廊"]]],"entries":[{"trad":"修道院","pinyin":"xiūdàoyuàn","senses":["monastery","convent"],"source":"cc-cedict","hv":"tu đạo viện"},{"trad":"修道院","pinyin":"xiūdàoyuàn","senses":["convent; monastery"],"pos":"noun","source":"wiktionary"}]},"目击者":{"examples":[["ud-pud-l10-001",7,10,"在藉记卡数据的帮助下，埃森的警察正在调查四名目击者，因为当一名退休员工在银行死掉的时候，他们在一旁袖手旁观。","在藉記卡數據的幫助下，埃森的警察正在調查四名目擊者，因為當一名退休員工在銀行死掉的時候，他們在一旁袖手旁觀。",["在","藉记卡","数据","的","帮助","下","警察","正","调查","名","因为","当","退休","员工","银行","死掉","时候","他们","旁","袖手旁观"]]],"entries":[{"trad":"目擊者","pinyi