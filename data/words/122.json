amples":[["ud-pud-l5-001",30,5,"但是在她和她与其它人的行为当中并没有显然艺术性的东西。","但是在她和她與其它人的行為當中並沒有顯然藝術性的東西。",["但是","在","她","和","与","其它","人","的","行为","当中","并","没有","显然","东西"]],["ud-pud-l7-002",46,7,"他们的复兴强调一个绝妙的挑战的吸引力，不论是否具艺术性：不适丶成长，以及充满意义的联系。","他們的復興強調一個絕妙的挑戰的吸引力，不論是否具藝術性：不適丶成長，以及充滿意義的聯繫。",["他们","的","复兴","强调","个","绝妙","挑战","吸引力","不论","是否","具","不适","成长","以及","充满","意义","联系"]]],"entries":[]},"顺序":{"examples":[["ud-pud-l5-002",22,5,"人们对事件的发生时间及发展顺序进行了热烈的讨论。","人們對事件的發生時間及發展順序進行了熱烈的討論。",["人们","对","事件","的","发生","时间","及","发展","进行","了","热烈","讨论"]]],"entries":[{"trad":"順序","pinyin":"shùnxù","senses":["sequence","order"],"source":"cc-cedict","hv":"thuận tự"},{"trad":"順序","pinyin":"shùnxù","senses":["sequence; order"],"pos":"noun","source":"wiktionary"},{"trad":"順序","pinyin":"shùnxù","senses":["in sequence; in order"],"pos":"adv","source":"wiktionary"},{"trad":"順序","pinyin":"shùnxù","senses":["suitable; harmonious","smooth; without difficulty; well","lucky; fortunate"],"pos":"adj","source":"wiktionary"}]},"顺从":{"examples":[["ud-pud-l7-001",16,7,"博格达汗称蒙古和中国在清朝时均由满族统治，但清朝于1911年灭亡后，蒙古顺从于满族的协议就已失效。","博格達汗稱蒙古和中國在清朝時均由滿族統治，但清朝於1911年滅亡後，蒙古順從於滿族的協議就已失效。",["称","和","在","时","均","由","统治","但","于","年","灭亡","后","的","协议","就","已","失效"]]],"entries":[{"trad":"順從","pinyin":"shùncóng","senses":["obedient","to comply","to submit","to defer"],"source":"cc-cedict","hv":"thuận tòng,tùng"},{"trad":"順從","pinyin":"shùncóng","senses":["to submit to; to yield to; to obey"],"pos":"verb","source":"wiktionary"},{"trad":"順從","pinyin":"shùncóng","senses":["amenable"],"pos":"adj","source":"wiktionary"}]}}