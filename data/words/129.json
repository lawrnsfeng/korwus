ict","hv":"viên"},{"trad":"袁","pinyin":"yuán","senses":["long","a surname"],"source":"wiktionary"}]},"极端":{"examples":[["ud-pud-l6-003",8,6,"非洲撒海尔区的气候与位于北部的撒哈拉沙漠的气候相似，但是其极端程度相对较低。","非洲撒海爾區的氣候與位於北部的撒哈拉沙漠的氣候相似，但是其極端程度相對較低。",["的","气候","与","位","于","北部","沙漠","相似","但是","其","程度","相对","较低"]]],"entries":[{"trad":"極端","pinyin":"jíduān","senses":["extreme"],"source":"cc-cedict","hv":"cực đoan"},{"trad":"極端","pinyin":"jíduān","senses":["extreme"],"pos":"noun","source":"wiktionary"},{"trad":"極端","pinyin":"jíduān","senses":["extreme"],"pos":"adj","source":"wiktionary"},{"trad":"極端","pinyin":"jíduān","senses":["extremely"],"pos":"adv","source":"wiktionary"}],"usage":{"n":6,"rank":4201,"gold":3,"machine":3,"lv":[0,0,0,0,0,4,2,0],"upos":[["ADJ",4,null],["ADV",1,null],["NOUN",1,["ud-pud-l6-003",8]]],"rel":[["xcomp",2],["advmod",1],["amod",1],["ccomp",1],["compound",1]]}},"极西北":{"examples":[["ud-pud-l7-001",11,7,"在极西北地区以外，泰加林具有统治地位，它覆盖了整个西伯利亚的一个重要部分。","在極西北地區以外，泰加林具有統治地位，它覆蓋了整個西伯利亞的一個重要部分。",["在","地区","以外","具有","统治","地位","它","覆盖","了","整个","的","个","重要","部分"]]],"entries":[]},"征服":{"examples":[["ud-pud-l7-004",46,7,"阿契美尼德军队征服了色雷斯、希腊的沿海城市以及培奥尼亚人。","阿契美尼德軍隊征服了色雷斯、希臘的沿海城市以及培奧尼亞人。",["军队","了","的","沿海","城市","以及"]],["ud-pud-l7-002",10,7,"有关该城市的最古老历史资料是在凯尔奈克图特摩斯圣殿中一处有关被征服地点的碑文中发现的。","有關該城市的最古老歷史資料是在凱爾奈克圖特摩斯聖殿中一處有關被征服地點的碑文中發現的。",["有关","该","城市","的","最","古老","历史","资料","是","在","圣殿","中","处","被","地点","碑文","发现"]]],"entries":[{"trad":"征服","pinyin":"zhēngfú","senses":["to conquer","to subdue","to vanquish"],"source":"cc-cedict","hv":"chinh phục"},{"trad":"征服","pinyin":"zhēngfú","senses":["to conquer using military force; to overpower; to subjugate","to captivate; to enthrall"],"pos":"verb","source":"wiktionary"}],"usage":{"n":14,"rank":2231,"gold":7,"machine":7,"lv":[0,0,0,0,0,0,14,0],"upos":[["VERB",14,["ud-pud-l7-004",46]]],"rel":[["ccomp",4],["xcomp",4],["acl:relcl",2],["root",2],["amod",1]],"with":[["被","aux:pass",1,4,["ud-pud-l7-002",10]],["的","mark:rel",1,3,null]]}},"极低":{"examples":[["ud-pud-l7-002