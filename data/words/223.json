rce":"wiktionary"}]},"统治":{"examples":[["ud-pud-l7-001",11,7,"在极西北地区以外，泰加林具有统治地位，它覆盖了整个西伯利亚的一个重要部分。","在極西北地區以外，泰加林具有統治地位，它覆蓋了整個西伯利亞的一個重要部分。",["在","极西北","地区","以外","具有","地位","它","覆盖","了","整个","的","个","重要","部分"]],["ud-pud-l7-001",16,7,"博格达汗称蒙古和中国在清朝时均由满族统治，但清朝于1911年灭亡后，蒙古顺从于满族的协议就已失效。","博格達汗稱蒙古和中國在清朝時均由滿族統治，但清朝於1911年滅亡後，蒙古順從於滿族的協議就已失效。",["称","和","在","时","均","由","但","于","年","灭亡","后","顺从","的","协议","就","已","失效"]],["ud-pud-l7-001",14,7,"在法国共和历3年雨月（1794年1月至二月），为了缓解恐怖统治时期的压力，他采取了多种方法来释放嫌疑犯。","在法國共和曆3年雨月（1794年1月至二月），為了緩解恐怖統治時期的壓力，他採取了多種方法來釋放嫌疑犯。",["在","共和历","年","雨月","月","至","为了","缓解","恐怖","时期","的","压力","他","采取","了","种","方法","来","释放","嫌疑犯"]]],"entries":[{"trad":"統治","pinyin":"tǒngzhì","senses":["to rule (a country)","to govern","rule","regime"],"source":"cc-cedict","hv":"thống trị"},{"trad":"統治","pinyin":"tǒngzhì","senses":["to govern; to rule; to preside over","to control; to dominate"],"pos":"verb","source":"wiktionary"}],"usage":{"n":29,"rank":1176,"gold":23,"machine":6,"lv":[0,0,0,0,0,0,27,2],"upos":[["VERB",16,["ud-pud-l7-001",16]],["NOUN",13,["ud-pud-l7-001",11]]],"rel":[["compound",8],["ccomp",4],["nmod",4],["obj",4],["acl:relcl",2]],"with":[["的","case",1,4,null],["由","ccomp",0,3,["ud-pud-l7-001",16]],["者","compound",0,3,null],["对","case",1,3,null]]}},"统治者":{"examples":[["ud-pud-l7-002",9,7,"除去实行严厉的政策之外，查尔斯被认为是一个对荷兰人的需求抱有同情心的统治者。","除去實行嚴厲的政策之外，查爾斯被認為是一個對荷蘭人的需求抱有同情心的統治者。",["除去","实行","严厉","的","政策","之外","被","认为","是","个","对","需求","抱有","同情心"]]],"entries":[{"trad":"統治者","pinyin":"tǒngzhìzhě","senses":["ruler"],"source":"cc-cedict","hv":"thống trị giả"},{"trad":"統治者","pinyin":"tǒngzhìzhě","senses":["ruler (a person exercising government or dominion)"],"pos":"noun","source":"wiktionary"}]},"槟榔树":{"examples":[["ud-pud-l10-001",34,10,"随后，逛早市（6.30-10am）：米棒棒糖，黄蜂茧（人们普遍认为蛹很美味），水牛肺，槟榔树树皮和叶，活蟾蜍和鲶鱼。","隨後，逛早市（6.30-10am）：米棒棒糖，黃蜂繭（人們普遍認為蛹很美味），水牛肺，檳榔樹樹皮和葉，活蟾蜍和鯰魚。",["随后","逛","早市","米","棒棒糖","黄蜂茧","人们","普遍","认为","蛹","很","美味","水牛","肺","树皮","和","叶","活蟾蜍","鲶鱼"]]],"entries":[]},"拟定":{"examples":[[