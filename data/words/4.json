ary"}]},"处之泰然":{"examples":[["ud-pud-l7-001",43,7,"他简直是太仁慈了，对事件处之泰然，而我实在怒不可遏。","他簡直是太仁慈了，對事件處之泰然，而我實在怒不可遏。",["他","简直","是","太","仁慈","了","对","事件","而","我","实在","怒不可遏"]]],"entries":[]},"处死":{"examples":[["ud-pud-l7-002",8,7,"党卫军军官、带领法兰西民兵追杀抵抗部队的约瑟夫·达尔南德于1945年10月被处死。","黨衛軍軍官、帶領法蘭西民兵追殺抵抗部隊的約瑟夫·達爾南德於1945年10月被處死。",["党卫军","军官","带领","民兵","追杀","抵抗","部队","的","于","年","月","被"]]],"entries":[{"trad":"處死","pinyin":"chǔsǐ","senses":["an execution","to put sb to death"],"source":"cc-cedict","hv":"xử tử"},{"trad":"處死","pinyin":"chǔsǐ / chúsǐ","senses":["to execute; to sentence to death; to carry out the death penalty"],"pos":"verb","source":"wiktionary"}]},"处罚":{"examples":[["ud-pud-l7-002",24,7,"深圳市交警以前曾选用非常规处罚。","深圳市交警以前曾選用非常規處罰。",["交警","以前","曾","选用","非","常规"]],["ud-pud-l7-004",13,7,"帖子上写著，我们今晚将使用高激光束进行处罚。","帖子上寫著，我們今晚將使用高激光束進行處罰。",["帖子","上","写","著","我们","今晚","将","使用","高激光束","进行"]]],"entries":[{"trad":"處罰","pinyin":"chǔfá","senses":["to penalize","to punish"],"source":"cc-cedict","hv":"xử phạt"},{"trad":"處罰","pinyin":"chǔfá","senses":["to punish; to penalise"],"pos":"verb","source":"wiktionary"},{"trad":"處罰","pinyin":"chǔfá","senses":["punishment; penalty"],"pos":"noun","source":"wiktionary"}]},"各天":{"examples":[["ud-pud-l7-003",10,7,"泰国每天的吉祥颜色是根据工作日表格来分配的，下面带有一个链接，可以打开当周各天的菩萨图片。","泰國每天的吉祥顏色是根據工作日表格來分配的，下面帶有一個鏈接，可以打開當週各天的菩薩圖片。",["每天","的","吉祥","颜色","是","根据","工作日","表格","来","分配","下面","带有","个","链接","可以","打开","当周","菩萨","图片"]]],"entries":[]},"各样":{"examples":[["ud-pud-l7-003",22,7,"为了娱乐大众，在1925年建了一个露天剧场在圣·迈克尔教堂前的大台阶上，此剧场现在仍在吸引各种各样的观众。","為了娛樂大眾，在1925年建了一個露天劇場在聖·邁克爾教堂前的大臺階上，此劇場現在仍在吸引各種各樣的觀眾。",["为了","娱乐","大众","在","年","建","了","个","露天","剧场","圣","教堂","前","的","大台阶","上","此","现在","仍","吸引","各种","观众"]]],"entries":[{"trad":"各樣","pinyin":"gèyàng","senses":["many different types"],"source":"cc-cedict","hv":"các dạng"},{"trad":"各樣","pinyin":"gèyàng","senses":["a variety of; all sorts of; all kinds of; a number of; every"],"pos":"pron","source":"wiktionary"}]},"射线":{"examples":[["ud-pud-l10-001",0,10,"罗娜发