es":["explosive; explosive substance"],"pos":"noun","source":"wiktionary"}]},"咸淳":{"examples":[["ud-gsdsimp-l7-004",2,7,"后来消息走漏，咸淳九年（西元1273年）当时的皇帝度宗为追究此案，扬言要屠村灭口，于是发生南雄珠玑巷居民避祸南迁之役。","後來消息走漏，鹹淳九年（西元1273年）當時的皇帝度宗為追究此案，揚言要屠村滅口，於是發生南雄珠璣巷居民避禍南遷之役。",["后来","消息","走漏","年","西元","当时","的","皇帝","度宗","为","追究","此案","扬言","要","屠村","灭口","于是","发生","巷","居民","避祸","南迁","之","役"]]],"entries":[{"trad":"咸淳","pinyin":"Xiánchún","senses":["the Xianchun era (1265–1274 CE), used by Emperor Duzong of Song"],"pos":"name","source":"wiktionary"}]},"蒸馏":{"examples":[["ud-gsdsimp-l10-001",12,10,"酪梨糖是利用高科技分子蒸馏法由天然酪梨中萃取。","酪梨糖是利用高科技分子蒸餾法由天然酪梨中萃取。",["酪梨","糖","是","利用","高","科技","分子","法","由","天然","中","萃取"]],["ud-gsdsimp-l10-004",31,10,"如果制作白苦艾酒或蓝色苦艾酒的话，蒸馏液会被浓缩装瓶；如果制作绿苦艾酒，则会添加天然或人工色素。","如果製作白苦艾酒或藍色苦艾酒的話，蒸餾液會被濃縮裝瓶；如果製作綠苦艾酒，則會添加天然或人工色素。",["如果","制作","白","苦艾","酒","或","蓝色","的话","液","会","被","浓缩","装瓶","绿","则","添加","天然","人工","色素"]]],"entries":[{"trad":"蒸餾","pinyin":"zhēngliú","senses":["to distill","distillation"],"source":"cc-cedict","hv":"chưng lưu"},{"trad":"蒸餾","pinyin":"zhēngliú / zhēngliù","senses":["to distill"],"pos":"verb","source":"wiktionary"}]},"麸氨酸":{"examples":[["ud-gsdsimp-l10-003",34,10,"谷氨酸（麸氨酸）是组成生物体内各种蛋白质的20种氨基酸之一。","穀氨酸（麩氨酸）是組成生物體內各種蛋白質的20種氨基酸之一。",["谷氨酸","是","组成","生物","体内","各种","蛋白质","的","种","氨基酸","之"]]],"entries":[]},"纸上":{"examples":[["ud-gsdsimp-l10-004",26,10,"将碳化硅粒子层压在纸上就能制成砂纸和滑板的握带。","將碳化硅粒子層壓在紙上就能製成砂紙和滑板的握帶。",["将","碳化","硅","粒子","层压","在","就","能","制成","砂纸","和","滑板","的","握带"]]],"entries":[],"usage":{"n":5,"rank":4766,"gold":1,"machine":4,"lv":[0,0,1,0,1,1,1,1],"upos":[["NOUN",5,["ud-gsdsimp-l10-004",26]]],"rel":[["obl",4],["iobj",1]],"with":[["在","case",1,4,["ud-gsdsimp-l10-004",26]],["画","obl",0,3,null]]}},"炸鸡":{"examples":[["ud-pud-l6-003",6,6,"中国人对炸鸡永不满足的胃口曾是投资者喜爱百胜餐饮集团（肯德基的母公司）的主要原因。","中國人對炸雞永不滿足的胃口曾是投資者喜愛百勝餐飲集團（肯德基的母公司）的主要原因。",["对","永","不","满足","的","胃口","曾","是","投资者","喜爱","餐饮","集团","母","公司","主要","原因"]]],"entries":[{"trad":"炸雞","pinyin":"zhájī","senses":["fried chicken"],"source":"cc-cedi