  {
    "id": "sample-3",
    "title": "A rainy weekend",
    "level": 4,
    "source": "written for korwus",
    "license": "CC0, written for korwus; glosses CC-CEDICT, CC BY-SA 4.0",
    "kind": "passage",
    "sentences": 3,
    "source_id": "korwus-written",
    "level_standard": "hsk2025",
    "translation": "Last weekend it rained heavily, so we did not go to the park. A friend and I watched a film at home and cooked a rich dinner. Although we did not go out, we had a very pleasant time."
  },
  {
    "id": "sample-5",
    "title": "Learning slowly",
    "level": 6,
    "source": "written for korwus",
    "license": "CC0, written for korwus; glosses CC-CEDICT, CC BY-SA 4.0",
    "kind": "passage",
    "sentences": 3,
    "source_id": "korwus-written",
    "level_standard": "hsk2025",
    "translation": "Learning a foreign language takes patience. At the start I always worried about saying something wrong, so I seldom spoke. Later I found that as long as you dare to make mistakes, progress comes much faster than you imagine."
  },
